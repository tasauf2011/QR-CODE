import qrcode
from tkinter import *
from PIL import Image, ImageTk

# Create window
window = Tk()
window.title("QR Code Generator")
window.geometry("450x550")
window.config(bg="white")

# Heading
heading = Label(
    window,
    text="QR Code Generator",
    font=("Arial", 22, "bold"),
    bg="white"
)
heading.pack(pady=20)

# Input box
entry = Entry(window, font=("Arial", 14), width=30)
entry.pack(pady=10)

# Result label
result_label = Label(window, text="", bg="white", font=("Arial", 12))
result_label.pack(pady=10)

# Image label
qr_label = Label(window, bg="white")
qr_label.pack(pady=10)


# Generate QR Code function
def generate_qr():

    text = entry.get()

    if text == "":
        result_label.config(text="Please enter something!", fg="red")
        qr_label.config(image="")
        return

    qr = qrcode.make(text)
    qr.save("my_qr.png")

    img = Image.open("my_qr.png")
    img = img.resize((250, 250))

    photo = ImageTk.PhotoImage(img)

    qr_label.config(image=photo)
    qr_label.image = photo

    result_label.config(
        text="QR Code Generated Successfully!",
        fg="green"
    )


# Generate button
button = Button(
    window,
    text="Generate QR Code",
    font=("Arial", 14),
    command=generate_qr
)
button.pack(pady=15)

# Run window
window.mainloop()
